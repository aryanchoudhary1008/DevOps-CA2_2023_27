{
  "title": "Quote Service Overview",
  "uid": "quote-service",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Uptime (target up)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "expr": "up{job=\"quote-service\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
      ] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "Request rate (req/s)",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (endpoint)", "legendFormat": "{{endpoint}}", "refId": "A" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "p95 latency (seconds)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Error rate (5xx and 4xx share)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m])) / sum(rate(http_requests_total[1m]))", "legendFormat": "error ratio", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    }
  ]
}
